      {
        "id": "multigit.repo9",
        "description": "Color de repositorio 9 (lima).",
        "defaults": {
          "dark": "#B5CC5A",
          "light": "#6B8E23",
          "highContrast": "#CBE070",
          "highContrastLight": "#55711A"
        }
      },
      {
        "id": "multigit.repo10",
        "description": "Color de repositorio 10 (cian).",
        "defaults": {
          "dark": "#56D4E8",
          "light": "#0E8FA6",
          "highContrast": "#70E6F7",
          "highContrastLight": "#0A7387"
        }
      },
      {
        "id": "multigit.repo11",
        "description": "Color de repositorio 11 (gris azulado).",
        "defaults": {
          "dark": "#8FA3BF",
          "light": "#5A6E8A",
          "highContrast": "#A9BBD4",
          "highContrastLight": "#46566E"
        }
      }
    ],
    "keybindings": [
      {
        "command": "multigit.branchPopup.rename",
        "key": "f2",
        "when": "inQuickOpen && multigit.branchPopupOpen"
      },
      {
        "command": "multigit.branchesTree.rename",
        "key": "f2",
        "when": "focusedView == multigit.branches"
      },
      {
        "command": "multigit.commitFocus",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "focusedView =~ /^multigit\\./ || activeWebviewPanelId == multigit.push"
      },
      {
        "command": "multigit.push",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k",
        "when": "focusedView =~ /^multigit\\./ || activeWebviewPanelId == multigit.push"
      },
      {
        "command": "multigit.updateProject",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "focusedView =~ /^multigit\\./ || activeWebviewPanelId == multigit.push"
      },
      {
        "command": "multigit.branches",
        "key": "ctrl+shift+alt+b",
        "mac": "cmd+shift+alt+b"
      },
      {
        "command": "multigit.branch.push",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k",
        "when": "focusedView == multigit.branches && viewItem =~ /^multigit\\.branch\\.local/"
      }
    ],
    "submenus": [
      {
        "id": "multigit.changes.groupBy",
        "label": "Agrupar por",
        "icon": "$(list-tree)"
      }
    ]
  },
  "scripts": {
    "build": "npm run typecheck && npm run build:ext && npm run build:webview",
    "build:dev": "npm run build:ext && npm run build:webview",
    "dev": "npm run build:dev && code --new-window --extensionDevelopmentPath=.",
    "build:ext": "node esbuild.mjs",
    "build:webview": "vite build --config webview-ui/vite.config.mts",
    "watch": "node esbuild.mjs --watch",
    "watch:webview": "vite build --watch --config webview-ui/vite.config.mts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p webview-ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run typecheck && node esbuild.mjs --production && npm run build:webview"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-window": "^1.8.8",
    "@types/vscode": "~1.100.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-window": "^1.8.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#11182B",
    "theme": "dark"
  }
}
