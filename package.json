        "category": "MultiGit",
        "toggled": "multigit.changesGroupByRepo"
      },
      {
        "command": "multigit.changes.toggleGroupByDir",
        "title": "Directorio",
        "category": "MultiGit",
        "toggled": "multigit.changesGroupByDir"
      },
      {
        "command": "multigit.openGitLog",
        "title": "Git Log",
        "category": "MultiGit",
        "icon": "$(history)"
      },
      {
        "command": "multigit.log.showBranch",
        "title": "Ver rama en Git Log",
        "category": "MultiGit"
      },
      {
        "command": "multigit.branchesTree.showInLog",
        "title": "Ver en Git Log",
        "category": "MultiGit",
        "icon": "$(history)"
      },
      {
        "command": "multigit.updateProject",
        "title": "Update Project",
        "category": "MultiGit",
        "icon": "$(sync)"
      },
      {
        "command": "multigit.branch.checkout",
        "title": "Checkout",
        "category": "MultiGit"
      },
      {
        "command": "multigit.branch.newBranchFrom",
        "title": "New Branch from Selected…",
        "category": "MultiGit"
      },
      {
        "command": "multigit.branch.checkoutAndRebase",
        "title": "Checkout and Rebase onto Current",
        "category": "MultiGit"
      },
      {
        "command": "multigit.branch.compare",
        "title": "Compare with Current",
        "category": "MultiGit"
      },
      {
        "command": "multigit.branch.diffWorkingTree",
        "title": "Show Diff with Working Tree",
        "category": "MultiGit"
      },
      {
        "command": "multigit.branch.rebaseOnto",
        "title": "Rebase Current onto Selected",
        "category": "MultiGit"
      },
      {
        "command": "multigit.branch.merge",
        "title": "Merge Selected into Current",
        "category": "MultiGit"
      },
      {
        "command": "multigit.branch.newWorktree",
        "title": "New Worktree from Selected…",
        "category": "MultiGit"
      },
      {
        "command": "multigit.branch.update",
        "title": "Update",
        "category": "MultiGit"
      },
      {
        "command": "multigit.branch.push",
        "title": "Push…",
        "category": "MultiGit"
      },
      {
        "command": "multigit.branch.delete",
        "title": "Delete",
        "category": "MultiGit"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "multigit.branches",
          "when": "view == multigit.repositories",
          "group": "navigation@1"
        },
        {
          "command": "multigit.fetch",
          "when": "view == multigit.repositories",
          "group": "navigation@2"
        },
        {
          "command": "multigit.pull",
          "when": "view == multigit.repositories",
          "group": "navigation@2.5"
        },
        {
          "command": "multigit.push",
          "when": "view == multigit.repositories",
          "group": "navigation@3"
        },
        {
          "command": "multigit.refresh",
          "when": "view == multigit.repositories",
          "group": "navigation@9"
        },
        {
          "command": "multigit.showLog",
          "when": "view == multigit.repositories",
          "group": "z_log"
        },
        {
          "command": "multigit.branchesTree.groupByBranch",
          "when": "view == multigit.branches && multigit.branchesGroupBy == repo",
          "group": "navigation@1"
        },
        {
          "command": "multigit.branchesTree.groupByRepo",
          "when": "view == multigit.branches && multigit.branchesGroupBy == branch",
          "group": "navigation@1"
        },
        {
          "command": "multigit.branchesTree.refresh",
          "when": "view == multigit.branches",
          "group": "navigation@9"
        },
        {
          "command": "multigit.showBranchesView",
          "when": "view == multigit.repositories",
          "group": "z_log@0"
        },
        {
          "command": "multigit.changes.rollback",
          "when": "view == multigit.changes",
          "group": "navigation@1"
        },
        {
          "command": "multigit.changes.refresh",
          "when": "view == multigit.changes",
          "group": "navigation@9"
        },
        {
          "command": "multigit.changes.shelve",
          "when": "view == multigit.changes",
          "group": "shelf@1"
        },
        {
          "command": "multigit.changes.unshelve",
          "when": "view == multigit.changes",
          "group": "shelf@2"
        },
        {
          "command": "multigit.commitFocus",
          "when": "view == multigit.repositories",
          "group": "z_log@-1"
        },
        {
          "submenu": "multigit.changes.groupBy",
          "when": "view == multigit.changes",
          "group": "navigation@5"
        },
        {
          "command": "multigit.openGitLog",
          "when": "view == multigit.repositories",
          "group": "z_log@-2"
        },
        {
          "command": "multigit.openGitLog",
          "when": "view == multigit.branches",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "multigit.repoBranches",
          "when": "view == multigit.repositories && viewItem == multigit.repo",
          "group": "inline"
        },
        {
          "command": "multigit.repoBranches",
          "when": "view == multigit.repositories && viewItem == multigit.repo",
          "group": "navigation"
        },
        {
          "command": "multigit.branchesTree.actions",
          "when": "view == multigit.branches && viewItem =~ /^multigit\\.branch\\./",
          "group": "inline"
        },
        {
          "command": "multigit.pull",
          "when": "view == multigit.repositories && viewItem == multigit.repo",
          "group": "navigation@2"
        },
        {
          "command": "multigit.push",
          "when": "view == multigit.repositories && viewItem == multigit.repo",
          "group": "navigation@3"
        },
        {
          "command": "multigit.changes.openFile",
          "when": "view == multigit.changes && viewItem =~ /^multigit\\.changes\\.file/",
          "group": "inline@1"
        },
        {
          "command": "multigit.changes.rollback",
          "when": "view == multigit.changes && viewItem =~ /^multigit\\.changes\\.(file\\.tracked|repo|dir|section)/",
          "group": "inline@2"
        },
        {
          "command": "multigit.changes.openDiff",
          "when": "view == multigit.changes && viewItem =~ /^multigit\\.changes\\.file/",
          "group": "navigation@1"
        },
        {
          "command": "multigit.changes.openFile",
          "when": "view == multigit.changes && viewItem =~ /^multigit\\.changes\\.file/",
          "group": "navigation@2"
        },
        {
          "command": "multigit.changes.rollback",
          "when": "view == multigit.changes && viewItem =~ /^multigit\\.changes\\.(file\\.tracked|repo|dir|section)/",
          "group": "navigation@3"
        },
        {
          "command": "multigit.branchesTree.showInLog",
          "when": "view == multigit.branches && viewItem =~ /^multigit\\.branch\\./",
          "group": "inline@0"
        },
        {
          "command": "multigit.branch.checkout",
          "when": "view == multigit.branches && viewItem =~ /^multigit\\.branch\\.(local|remote)$/",
          "group": "1_checkout@1"
        },
        {
          "command": "multigit.branch.newBranchFrom",
          "when": "view == multigit.branches && viewItem =~ /^multigit\\.branch\\./",
          "group": "1_checkout@2"
        },
        {
          "command": "multigit.branch.checkoutAndRebase",
          "when": "view == multigit.branches && viewItem == multigit.branch.local",
          "group": "1_checkout@3"
        },
        {
          "command": "multigit.branch.compare",
          "when": "view == multigit.branches && viewItem =~ /^multigit\\.branch\\.(local|remote)$/",
          "group": "2_compare@1"
        },
        {
          "command": "multigit.branch.diffWorkingTree",
          "when": "view == multigit.branches && viewItem =~ /^multigit\\.branch\\./",
          "group": "2_compare@2"
        },
        {
          "command": "multigit.branch.rebaseOnto",
          "when": "view == multigit.branches && viewItem =~ /^multigit\\.branch\\.(local|remote)$/",
          "group": "3_merge@1"
        },
        {
          "command": "multigit.branch.merge",
          "when": "view == multigit.branches && viewItem =~ /^multigit\\.branch\\.(local|remote)$/",
          "group": "3_merge@2"
        },
        {
          "command": "multigit.branch.newWorktree",
          "when": "view == multigit.branches && viewItem =~ /^multigit\\.branch\\.(local|remote)$/",
          "group": "4_worktree@1"
        },
        {
          "command": "multigit.branch.update",
          "when": "view == multigit.branches && viewItem =~ /^multigit\\.branch\\./",
          "group": "5_update@1"
        },
        {
          "command": "multigit.branch.push",
          "when": "view == multigit.branches && viewItem =~ /^multigit\\.branch\\.local/",
          "group": "5_update@2"
        },
        {
          "command": "multigit.branch.delete",
          "when": "view == multigit.branches && viewItem =~ /^multigit\\.branch\\.(local|remote)$/",
          "group": "6_edit@2"
        },
        {
          "command": "multigit.branchesTree.rename",
          "when": "view == multigit.branches && viewItem =~ /^multigit\\.branch\\.local/",
          "group": "6_edit@1"
        },
        {
          "command": "multigit.branchesTree.showInLog",
          "when": "view == multigit.branches && viewItem =~ /^multigit\\.branch\\./",
          "group": "7_log@1"
        }
      ],
      "commandPalette": [
        {
          "command": "multigit.repoBranches",
          "when": "false"
        },
        {
          "command": "multigit.branchPopup.rename",
          "when": "false"
        },
        {
          "command": "multigit.branchesTree.actions",
          "when": "false"
        },
        {
          "command": "multigit.branchesTree.rename",
          "when": "false"
        },
        {
          "command": "multigit.branchesTree.groupByBranch",
          "when": "false"
        },
        {
          "command": "multigit.branchesTree.groupByRepo",
          "when": "false"
        },
        {
          "command": "multigit.changes.openDiff",
          "when": "false"
        },
        {
          "command": "multigit.changes.openFile",
          "when": "false"
        },
        {
          "command": "multigit.changes.toggleGroupByRepo",
          "when": "false"
        },
        {
          "command": "multigit.changes.toggleGroupByDir",
          "when": "false"
        },
        {
          "command": "multigit.log.showBranch",
          "when": "false"
        },
        {
          "command": "multigit.branchesTree.showInLog",
          "when": "false"
        },
        {
          "command": "multigit.branch.checkout",
          "when": "false"
        },
        {
          "command": "multigit.branch.newBranchFrom",
          "when": "false"
        },
        {
          "command": "multigit.branch.checkoutAndRebase",
          "when": "false"
        },
        {
          "command": "multigit.branch.compare",
          "when": "false"
        },
        {
          "command": "multigit.branch.diffWorkingTree",
          "when": "false"
        },
        {
          "command": "multigit.branch.rebaseOnto",
          "when": "false"
        },
        {
          "command": "multigit.branch.merge",
          "when": "false"
        },
        {
          "command": "multigit.branch.newWorktree",
          "when": "false"
        },
        {
          "command": "multigit.branch.update",
          "when": "false"
        },
        {
          "command": "multigit.branch.push",
          "when": "false"
        },
        {
          "command": "multigit.branch.delete",
          "when": "false"
        }
      ],
      "multigit.changes.groupBy": [
        {
          "command": "multigit.changes.toggleGroupByRepo",
          "group": "1@1"
        },
        {
          "command": "multigit.changes.toggleGroupByDir",
          "group": "1@2"
        }
      ]
    },
    "configuration": {
      "title": "MultiGit",
      "properties": {
        "multigit.scanDepth": {
          "type": "integer",
          "default": 2,
          "minimum": 0,
          "maximum": 5,
          "order": 0,
          "markdownDescription": "Profundidad máxima (en carpetas) para buscar repositorios `.git` dentro de cada carpeta del workspace. `0` revisa solo la carpeta raíz. Además se usan los repos que ya detecta la extensión Git de VS Code."
        },
        "multigit.ignoredRepos": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "order": 1,
          "markdownDescription": "Repositorios que MultiGit no debe mostrar ni tocar. Cada entrada se compara con el nombre de la carpeta o con su ruta relativa al workspace; admite `*` y `**`. Ejemplo: `[\"shell\", \"legacy/*\"]`."
        },
        "multigit.favoriteBranches": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "develop",
            "production-lt"
          ],
          "order": 2,
          "markdownDescription": "Ramas favoritas: aparecen arriba con ★ en el popup de ramas, la vista Ramas y el Git Log."
        },
        "multigit.autoFetchMinutes": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 1440,
          "order": 3,
          "markdownDescription": "Cada cuántos minutos hacer `git fetch --all --prune` en todos los repositorios. `0` lo desactiva."
        },
        "multigit.confirmCheckoutWithChanges": {
          "type": "boolean",
          "default": true,
          "order": 4,
          "markdownDescription": "Avisar antes de hacer checkout en repos con cambios sin commit. Las operaciones destructivas (rollback, delete, reset, force push) **siempre** piden confirmación."
        }
      }
    },
