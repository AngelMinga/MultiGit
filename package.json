{
  "name": "multigit",
  "displayName": "MultiGit",
  "description": "Git multi-repositorio al estilo IntelliJ IDEA: ramas comunes, commit, push, pull y log con grafo para todos los repos del workspace a la vez.",
  "version": "0.1.3",
  "publisher": "angelminga",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AngelMinga/claude-commit",
    "directory": "MultiGit"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "git",
    "multi-repo",
    "multiple repositories",
    "monorepo",
    "micro-frontends",
    "intellij",
    "branches",
    "git log",
    "git graph",
    "commit",
    "push",
    "pull"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.git",
    "workspaceContains:*/.git/HEAD",
    "workspaceContains:*/*/.git/HEAD"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "multigit",
          "title": "MultiGit",
          "icon": "media/multigit.svg"
        }
      ],
      "panel": [
        {
          "id": "multigit-panel",
          "title": "MultiGit",
          "icon": "media/multigit.svg"
        }
      ]
    },
    "views": {
      "multigit": [
        {
          "id": "multigit.toolbar",
          "name": "Proyecto",
          "type": "webview",
          "icon": "media/multigit.svg",
          "visibility": "visible"
        },
        {
          "id": "multigit.changes",
          "name": "Changes",
          "icon": "media/multigit-commit.svg",
          "visibility": "visible"
        },
        {
          "id": "multigit.commit",
          "name": "Commit",
          "type": "webview",
          "icon": "media/multigit-commit.svg",
          "visibility": "visible"
        },
        {
          "id": "multigit.repositories",
          "name": "Repositorios",
          "icon": "media/multigit.svg",
          "visibility": "visible"
        },
        {
          "id": "multigit.branches",
          "name": "Ramas",
          "icon": "$(git-branch)",
          "visibility": "visible"
        }
      ],
      "multigit-panel": [
        {
          "id": "multigit.log",
          "name": "Git Log",
          "type": "webview",
          "icon": "media/multigit.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "multigit.repositories",
        "contents": "No se detectaron repositorios Git en el workspace.\n[Refrescar repositorios](command:multigit.refresh)"
      },
      {
        "view": "multigit.changes",
        "contents": "No hay cambios sin commit en los repositorios.\n[Refrescar](command:multigit.changes.refresh)"
      }
    ],
    "commands": [
      {
        "command": "multigit.refresh",
        "title": "Refrescar repositorios",
        "category": "MultiGit",
        "icon": "$(refresh)"
      },
      {
        "command": "multigit.fetch",
        "title": "Fetch en todos los repositorios",
        "category": "MultiGit",
        "icon": "$(repo-fetch)"
      },
      {
        "command": "multigit.branches",
        "title": "Ramas…",
        "category": "MultiGit",
        "icon": "$(git-branch)"
      },
      {
        "command": "multigit.showLog",
        "title": "Mostrar log",
        "category": "MultiGit",
        "icon": "$(output)"
      },
      {
        "command": "multigit.repoBranches",
        "title": "Ramas de este repositorio…",
        "category": "MultiGit",
        "icon": "$(git-branch)"
      },
      {
        "command": "multigit.branchPopup.rename",
        "title": "Renombrar rama",
        "category": "MultiGit"
      },
      {
        "command": "multigit.branchesTree.actions",
        "title": "Acciones de la rama…",
        "category": "MultiGit",
        "icon": "$(ellipsis)"
      },
      {
        "command": "multigit.branchesTree.rename",
        "title": "Renombrar rama…",
        "category": "MultiGit",
        "icon": "$(edit)"
      },
      {
        "command": "multigit.branchesTree.groupByBranch",
        "title": "Agrupar por rama",
        "category": "MultiGit",
        "icon": "$(list-flat)"
      },
      {
        "command": "multigit.branchesTree.groupByRepo",
        "title": "Agrupar por repositorio",
        "category": "MultiGit",
        "icon": "$(list-tree)"
      },
      {
        "command": "multigit.branchesTree.refresh",
        "title": "Refrescar ramas",
        "category": "MultiGit",
        "icon": "$(refresh)"
      },
      {
        "command": "multigit.push",
        "title": "Push Commits…",
        "category": "MultiGit",
        "icon": "$(repo-push)"
      },
      {
        "command": "multigit.showBranchesView",
        "title": "Mostrar vista Ramas",
        "category": "MultiGit",
        "icon": "$(list-tree)"
      },
      {
        "command": "multigit.pull",
        "title": "Pull…",
        "category": "MultiGit",
        "icon": "$(repo-pull)"
      },
      {
        "command": "multigit.commitFocus",
        "title": "Commit…",
        "category": "MultiGit",
        "icon": "$(git-commit)"
      },
      {
        "command": "multigit.changes.refresh",
        "title": "Refrescar cambios",
        "category": "MultiGit",
        "icon": "$(refresh)"
      },
      {
        "command": "multigit.changes.rollback",
        "title": "Rollback…",
        "category": "MultiGit",
        "icon": "$(discard)"
      },
      {
        "command": "multigit.changes.shelve",
        "title": "Shelve Changes…",
        "category": "MultiGit",
        "icon": "$(archive)"
      },
      {
        "command": "multigit.changes.unshelve",
        "title": "Unshelve…",
        "category": "MultiGit",
        "icon": "$(inbox)"
      },
      {
        "command": "multigit.changes.openDiff",
        "title": "Ver diff",
        "category": "MultiGit",
        "icon": "$(diff)"
      },
      {
        "command": "multigit.changes.openFile",
        "title": "Abrir archivo",
        "category": "MultiGit",
        "icon": "$(go-to-file)"
      },
      {
        "command": "multigit.changes.toggleGroupByRepo",
